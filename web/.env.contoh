# Salin jadi .env, lalu sesuaikan kalau backend dijalankan di alamat lain.
#
# Bawaannya profil "http" di backend/src/UpnvjSuruh.Api/Properties/launchSettings.json.
# Sengaja tidak ditulis mati di dalam kode: alamat server yang ikut ter-commit akan
# terbawa ke build siapa pun yang lupa menggantinya.
VITE_API_BASE_URL=http://localhost:5059
